{
  "$schema": "https://wealthpark-design-team.github.io/design-kit/assets/tokens.json",
  "name": "WealthPark Design Kit",
  "source": "https://github.com/wealthpark-design-team/design-kit",
  "color": {
    "black": "#1A1A1A",
    "white": "#FFFFFF",
    "gray": "#333333",
    "textMuted": "#666666",
    "bg": "#F5F5F5",
    "border": "#EEEEEE",
    "borderStrong": "#CCCCCC",
    "accent": {
      "corporate": "#B8A86F",
      "business": "#2E6CFF",
      "dxConsulting": null,
      "careers": null,
      "realEstateTechnologies": null
    },
    "logo": {
      "main": "#000000",
      "inverse": "#FFFFFF"
    }
  },
  "font": {
    "familyBase": "'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'BIZ UDPGothic', Meiryo, sans-serif",
    "familyHero": "'Noto Sans JP', 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', sans-serif",
    "size": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 22, "2xl": 24, "3xl": 30, "4xl": 40, "5xl": 50, "6xl": 64, "7xl": 72 },
    "lineHeight": { "body": 1.7, "heading": 1.25 },
    "weight": { "regular": 400, "bold": 700 }
  },
  "space": { "2xs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 30, "2xl": 40, "3xl": 60, "4xl": 80 },
  "radius": { "sm": 3, "md": 4, "lg": 12, "pill": 999 },
  "border": { "regular": 1, "strong": 2 },
  "control": { "height": 40, "heightLg": 50 }
}
